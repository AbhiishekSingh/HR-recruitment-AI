# Copy this file to .env and fill in real values. .env is gitignored and
# never committed -- this file is the only source of truth for which
# variables the backend actually reads (see app/config.py). Every value here
# either matches the default Settings() already falls back to, or is left
# blank/placeholder for you to fill in.

APP_ENV=development
APP_SECRET_KEY=change-me

# --- Database & queue -------------------------------------------------
# Postgres must have the pgvector extension installed (CREATE EXTENSION
# vector;) before `alembic upgrade head` will succeed.
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/shortlistos
REDIS_URL=redis://localhost:6379/0

# --- LLM (GPT-5 extraction + scoring) ----------------------------------
LLM_PROVIDER=gpt5
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-5

# --- Embeddings ---------------------------------------------------------
# NOTE: changing EMBEDDING_MODEL_NAME to anything other than
# text-embedding-3-large changes the vector dimension (see
# app/models/candidate_embedding.py EMBEDDING_DIM=3072). That requires a
# migration + re-embedding the whole candidate pool, not just this edit.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-large

# --- File storage ---------------------------------------------------------
UPLOAD_DIR=./uploads

# --- Matching pipeline tuning ---------------------------------------------
# How many candidates hybrid_search returns per job before GPT-5 scores them.
DEFAULT_TOP_K=150
# Fusion weights for hybrid_search (must sum to 1.0). Higher dense weight
# leans on semantic similarity; higher keyword weight leans on exact-term
# matches from the JD.
HYBRID_DENSE_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
