# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production

# Database
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resume_screening
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://resume_app:change-me@db:5432/resume_screening

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0

# LLM provider (GPT-5)
LLM_PROVIDER=gpt5
OPENAI_API_KEY=sk-replace-me
LLM_MODEL_NAME=gpt-5

# Embedding provider (swappable)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-large
EMBEDDING_API_KEY=sk-replace-me

# File storage (local VPS disk, not S3)
UPLOAD_DIR=/app/uploads

# Matching defaults
DEFAULT_TOP_K=150
HYBRID_DENSE_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3
